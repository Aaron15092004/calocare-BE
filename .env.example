# Server
PORT=1509
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/calovie

# JWT - use long random values in every environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Web OAuth
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:1509/api/auth/google/callback
GOOGLE_NATIVE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# Sign in with Apple
APPLE_CLIENT_ID=com.calovie.app
APPLE_CLIENT_IDS=com.calovie.app
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
APPLE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Public clients
FRONTEND_URL=http://localhost:2004
CLIENT_URL=http://localhost:2004
PUBLIC_API_URL=http://localhost:1509

# AI and RAG
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
SCAN_VISION_TIMEOUT_MS=45000
SCAN_EMBEDDING_TIMEOUT_MS=12000
VOYAGE_API_KEY=your-voyage-api-key
GROQ_API_KEY=your-groq-api-key
VECTOR_STORE=atlas
QDRANT_URL=
QDRANT_API_KEY=
CHAT_SESSION_TTL_DAYS=30

# Food data providers
FATSECRET_KEY=your-fatsecret-key
FATSECRET_SECRET=your-fatsecret-secret
UNSPLASH_ACCESS_KEY=your-unsplash-key
UNSPLASH_TIER=demo

# Uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Web payments (PayOS remains web-only for consumer native purchases)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
WEBHOOK_SECRET=replace-with-a-long-webhook-secret

# RevenueCat native subscription sync - never expose this value to mobile clients
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_key
REVENUECAT_WEBHOOK_AUTH=replace-with-a-long-random-webhook-secret
REVENUECAT_PREMIUM_PRODUCT_IDS=calovie_premium_monthly
REVENUECAT_FAMILY_PRODUCT_IDS=calovie_family_monthly
REVENUECAT_PREMIUM_ENTITLEMENTS=premium
REVENUECAT_FAMILY_ENTITLEMENTS=family

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="CaloVie <support@calovie.app>"
